rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'bankasia.prioritybanking@gmail.com' ||
        request.auth.token.email.matches('.*@bankasia-bd\\.com$') && getUserData().roleIds.hasAny(['admin', 'ADMIN'])
      );
    }

    function isEditor() {
      return isSignedIn() && (
        isAdmin() || 
        (request.auth.token.email.matches('.*@bankasia-bd\\.com$') && getUserData().roleIds.hasAny(['editor', 'EDITOR', 'PRM', 'PSRM']))
      );
    }

    function isViewer() {
      return isSignedIn() && (
        isEditor() || 
        (request.auth.token.email.matches('.*@bankasia-bd\\.com$') && getUserData().roleIds.hasAny(['viewer', 'VIEWER']))
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'roleIds', 'branch', 'status', 'isLocked']) &&
             data.uid is string &&
             data.email is string && (data.email.matches('.*@bankasia-bd\\.com$') || data.email == 'bankasia.prioritybanking@gmail.com') &&
             data.name is string && data.name.size() <= 100 &&
             data.roleIds is list &&
             data.branch is string &&
             data.status in ['ACTIVE', 'INACTIVE', 'BLOCKED'] &&
             data.isLocked is bool &&
             (!data.keys().hasAny(['passwordLastChanged']) || data.passwordLastChanged is timestamp) &&
             (!data.keys().hasAny(['mustChangePassword']) || data.mustChangePassword is bool);
    }

    function hasPermission(perm) {
      // Logic to check if any of the user's roles contains the permissionId
      // This is expensive in rules, but fits the 'limit access based on rights' requirement.
      // For this implementation, we'll assume a 'rights' field on the user if available,
      // or check their group membership.
      return isAdmin() || getUserData().roleIds.hasAny(['admin', 'editor']);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidRole(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() <= 100 &&
             (!data.keys().hasAny(['description']) || data.description is string) &&
             (!data.keys().hasAny(['parentRoleId']) || (data.parentRoleId is string || data.parentRoleId == null)) &&
             (!data.keys().hasAny(['permissionIds']) || data.permissionIds is list);
    }

    function isValidPermission(data) {
      return data.keys().hasAll(['name', 'module']) &&
             data.name is string && data.name.size() <= 100 &&
             data.module is string && data.module.size() <= 100;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['customerId', 'name', 'segment', 'branch', 'rmId', 'status', 'createdAt']) &&
             data.customerId is string && data.customerId.size() <= 64 &&
             data.name is string && data.name.size() <= 100 &&
             data.segment is string && data.branch is string &&
             data.rmId is string && data.status is string &&
             data.createdAt == request.time;
    }

    function isValidServiceRequest(data) {
      return data.keys().hasAll(['customer_name', 'service_type', 'created_by', 'createdAt']) &&
             (!data.keys().hasAny(['request_id']) || data.request_id is string) &&
             (!data.keys().hasAny(['customer_id']) || data.customer_id is string) &&
             data.customer_name is string && data.service_type is string &&
             (!data.keys().hasAny(['service_category']) || data.service_category in ["on_request", "annual_service", "coupon_based"]) &&
             (!data.keys().hasAny(['description']) || data.description is string) &&
             (!data.keys().hasAny(['priority']) || data.priority in ["low", "medium", "high", "urgent"]) &&
             (!data.keys().hasAny(['status']) || data.status in ["draft", "pending_cm", "pending_hopb", "in_progress", "awaiting_customer", "approved", "rejected", "resolved", "completed"]) &&
             (!data.keys().hasAny(['assigned_to']) || data.assigned_to is string) &&
             (!data.keys().hasAny(['cm_approval']) || data.cm_approval in ["pending", "approved", "rejected"]) &&
             (!data.keys().hasAny(['hopb_approval']) || data.hopb_approval in ["pending", "approved", "rejected"]) &&
             (!data.keys().hasAny(['cm_remarks']) || data.cm_remarks is string) &&
             (!data.keys().hasAny(['hopb_remarks']) || data.hopb_remarks is string) &&
             (!data.keys().hasAny(['due_date']) || data.due_date is string) &&
             (!data.keys().hasAny(['cost']) || data.cost is number) &&
             (!data.keys().hasAny(['documents']) || data.documents is list) &&
             data.created_by == request.auth.token.email &&
             data.createdAt == request.time;
    }

    function isValidUserGroup(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() <= 100 &&
             (!data.keys().hasAny(['rights']) || data.rights is list) &&
             (!data.keys().hasAny(['status']) || data.status in ['active', 'inactive']);
    }

    function isValidBirthdayReminder(data) {
      return data.keys().hasAll(['customerId', 'customerName', 'reminderDate', 'message', 'status', 'createdById', 'createdAt']) &&
             data.customerId is string && data.customerName is string &&
             data.reminderDate is string && data.message is string && data.message.size() <= 500 &&
             (!data.keys().hasAny(['sendEmail']) || data.sendEmail is bool) &&
             (!data.keys().hasAny(['customerEmail']) || data.customerEmail is string) &&
             (!data.keys().hasAny(['emailSubject']) || data.emailSubject is string) &&
             (!data.keys().hasAny(['emailBody']) || data.emailBody is string) &&
             data.status in ['pending', 'dismissed'] &&
             data.createdById == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['userId', 'action', 'description', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.action is string &&
             data.createdAt == request.time;
    }

    function isValidSystemParameter(data) {
      return data.keys().hasAll(['param_key', 'param_value', 'createdAt']) &&
             data.param_key is string && data.param_key.size() <= 64 &&
             data.param_value is string && data.param_value.size() <= 1024 &&
             (!data.keys().hasAny(['category']) || data.category in ["general", "email", "sms", "notification", "service", "threshold"]) &&
             (!data.keys().hasAny(['description']) || data.description is string && data.description.size() <= 2048) &&
             (!data.keys().hasAny(['is_active']) || data.is_active is bool) &&
             data.createdAt == request.time;
    }

    // Role-based Right Checks (Hypothetical helper)
    function hasRight(right) {
      // This would typically involve checking user groups, but for now we check isAdmin
      // or a simplified rights check if the user object had a rights array.
      // Given the prompt, we'll check if the user is an admin or has the right.
      return isAdmin(); 
    }

    // users
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'avatarUrl', 'displayPreferences', 'updatedAt'])) ||
        isAdmin()
      ) && isValidUser(incoming());
    }

    // userGroups
    match /userGroups/{groupId} {
      allow read: if isViewer();
      allow create: if isAdmin() && isValidUserGroup(incoming());
      allow update: if isEditor() && 
                     isValidUserGroup(incoming()) &&
                     incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'rights', 'status', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // roles & permissions
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidRole(incoming());
    }

    match /permissions/{permissionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidPermission(incoming());
    }

    // leaves
    match /userLeaves/{leaveId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid);
    }

    // audit logs (Immutable)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    // systemParameters
    match /systemParameters/{parameterId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidSystemParameter(incoming());
      allow update: if isAdmin() && isValidSystemParameter(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['param_value', 'category', 'description', 'is_active', 'updatedAt']) && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // customers
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidCustomer(incoming());
      allow update: if isAdmin() && isValidCustomer(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'status', 'updatedAt']);
    }

    // userRequests (formerly ServiceRequests)
    function isTeamLead() {
      return isSignedIn() && (
        isAdmin() || 
        (request.auth.token.email.matches('.*@bankasia-bd\\.com$') && getUserData().roleIds.hasAny(['team_lead', 'TEAM_LEAD']))
      );
    }

    match /userRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.created_by == request.auth.token.email ||
        resource.data.assigned_to == request.auth.token.email ||
        resource.data.customer_id == request.auth.token.email ||
        isAdmin() ||
        isTeamLead()
      );
      allow create: if isSignedIn() && 
                    isValidServiceRequest(incoming()) && 
                    incoming().created_by == request.auth.token.email;
      allow update: if isSignedIn() && (
        existing().created_by == request.auth.token.email ||
        existing().assigned_to == request.auth.token.email ||
        isAdmin() ||
        isTeamLead()
      ) && incoming().created_by == existing().created_by && 
           incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // birthdayReminders
    match /birthdayReminders/{reminderId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.createdById == request.auth.uid);
      allow create: if isSignedIn() && isValidBirthdayReminder(incoming());
      allow update: if isSignedIn() && resource.data.createdById == request.auth.uid && 
                     incoming().diff(existing()).affectedKeys().hasOnly(['status', 'message', 'reminderDate', 'sendEmail', 'customerEmail', 'emailSubject', 'emailBody', 'updatedAt']) &&
                     isValidBirthdayReminder(incoming()) &&
                     incoming().createdById == existing().createdById;
      allow delete: if isSignedIn() && (isAdmin() || resource.data.createdById == request.auth.uid);
    }
  }
}
