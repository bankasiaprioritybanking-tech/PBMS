rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'bankasia.prioritybanking@gmail.com' ||
        request.auth.token.email.matches('.*@bankasia-bd\\.com$') && getUserData().roleIds.hasAny(['admin', 'ADMIN'])
      );
    }

    function isEditor() {
      return isSignedIn() && (
        isAdmin() || 
        (request.auth.token.email.matches('.*@bankasia-bd\\.com$') && getUserData().roleIds.hasAny(['editor', 'EDITOR', 'PRM', 'PSRM']))
      );
    }

    function isViewer() {
      return isSignedIn() && (
        isEditor() || 
        (request.auth.token.email.matches('.*@bankasia-bd\\.com$') && getUserData().roleIds.hasAny(['viewer', 'VIEWER']))
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'roleIds', 'branch', 'status', 'isLocked']) &&
             data.uid is string &&
             data.email is string && (data.email.matches('.*@bankasia-bd\\.com$') || data.email == 'bankasia.prioritybanking@gmail.com') &&
             data.name is string && data.name.size() <= 100 &&
             data.roleIds is list &&
             data.branch is string &&
             data.status in ['ACTIVE', 'INACTIVE', 'BLOCKED'] &&
             data.isLocked is bool &&
             (!data.keys().hasAny(['passwordLastChanged']) || data.passwordLastChanged is timestamp) &&
             (!data.keys().hasAny(['mustChangePassword']) || data.mustChangePassword is bool);
    }

    function hasPermission(perm) {
      // Logic to check if any of the user's roles contains the permissionId
      // This is expensive in rules, but fits the 'limit access based on rights' requirement.
      // For this implementation, we'll assume a 'rights' field on the user if available,
      // or check their group membership.
      return isAdmin() || getUserData().roleIds.hasAny(['admin', 'editor']);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'roleIds']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.roleIds is list;
    }

    function isValidRole(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() <= 100 &&
             (!data.keys().hasAny(['permissionIds']) || data.permissionIds is list);
    }

    function isValidPermission(data) {
      return data.keys().hasAll(['name', 'module']) &&
             data.name is string && data.name.size() <= 100 &&
             data.module is string && data.module.size() <= 100;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['customerId', 'name', 'segment', 'branch', 'rmId', 'status', 'createdAt']) &&
             data.customerId is string && data.customerId.size() <= 64 &&
             data.name is string && data.name.size() <= 100 &&
             data.segment is string && data.branch is string &&
             data.rmId is string && data.status is string &&
             data.createdAt == request.time;
    }

    function isValidServiceRequest(data) {
      return data.keys().hasAll(['requestId', 'customerId', 'serviceType', 'stage', 'status', 'createdAt']) &&
             data.requestId is string && data.requestId.size() <= 64 &&
             data.customerId is string && data.serviceType is string &&
             data.stage is string && data.status is string &&
             data.createdAt == request.time;
    }

    function isValidUserGroup(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() <= 100 &&
             (!data.keys().hasAny(['rights']) || data.rights is list) &&
             (!data.keys().hasAny(['status']) || data.status in ['active', 'inactive']);
    }

    function isValidBirthdayReminder(data) {
      return data.keys().hasAll(['customerId', 'customerName', 'reminderDate', 'message', 'status', 'createdById', 'createdAt']) &&
             data.customerId is string && data.customerName is string &&
             data.reminderDate is string && data.message is string && data.message.size() <= 500 &&
             data.status in ['pending', 'dismissed'] &&
             data.createdById == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['userId', 'action', 'description', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.action is string &&
             data.createdAt == request.time;
    }

    // Role-based Right Checks (Hypothetical helper)
    function hasRight(right) {
      // This would typically involve checking user groups, but for now we check isAdmin
      // or a simplified rights check if the user object had a rights array.
      // Given the prompt, we'll check if the user is an admin or has the right.
      return isAdmin(); 
    }

    // users
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'avatarUrl', 'displayPreferences', 'updatedAt'])) ||
        isAdmin()
      ) && isValidUser(incoming());
    }

    // userGroups
    match /userGroups/{groupId} {
      allow read: if isViewer();
      allow create: if isAdmin() && isValidUserGroup(incoming());
      allow update: if isEditor() && 
                     isValidUserGroup(incoming()) &&
                     incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'rights', 'status', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // roles & permissions
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidRole(incoming());
    }

    match /permissions/{permissionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidPermission(incoming());
    }

    // leaves
    match /userLeaves/{leaveId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid);
    }

    // audit logs (Immutable)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    // customers
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidCustomer(incoming());
      allow update: if isAdmin() && isValidCustomer(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'status', 'updatedAt']);
    }

    // userRequests (formerly ServiceRequests)
    match /userRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidServiceRequest(incoming()) && exists(/databases/$(database)/documents/customers/$(incoming().customerId));
      allow update: if isSignedIn() && isValidServiceRequest(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['stage', 'status', 'updatedAt']);
    }

    // birthdayReminders
    match /birthdayReminders/{reminderId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.createdById == request.auth.uid);
      allow create: if isSignedIn() && isValidBirthdayReminder(incoming());
      allow update: if isSignedIn() && resource.data.createdById == request.auth.uid && 
                     incoming().diff(existing()).affectedKeys().hasOnly(['status', 'message', 'reminderDate']) &&
                     isValidBirthdayReminder(incoming()) &&
                     incoming().createdById == existing().createdById;
      allow delete: if isSignedIn() && (isAdmin() || resource.data.createdById == request.auth.uid);
    }
  }
}
