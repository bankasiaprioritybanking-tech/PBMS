{
  "entities": {
    "User": {
      "title": "User",
      "description": "System users with banking-specific designations",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "userId": { "type": "string", "description": "Banking Staff ID" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "branch": { "type": "string" },
        "division": { "type": "string" },
        "functionalDesignation": { "type": "string" },
        "roleIds": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "References to role document IDs"
        },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "BLOCKED"] },
        "isLocked": { "type": "boolean" },
        "mustChangePassword": { "type": "boolean" },
        "avatarUrl": { "type": "string" },
        "displayPreferences": {
          "type": "object",
          "properties": {
            "theme": { "type": "string", "enum": ["light", "dark", "system"] },
            "notifications": { "type": "boolean" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "roleIds"]
    },
    "Role": {
      "title": "Role",
      "description": "Predefined banking roles",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "parentRoleId": { "type": "string", "description": "Reference to parent role ID" },
        "permissionIds": { 
          "type": "array", 
          "items": { "type": "string" }
        }
      },
      "required": ["name"]
    },
    "Permission": {
      "title": "Permission",
      "description": "Granular system rights",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "module": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name", "module"]
    },
    "UserLeave": {
      "title": "UserLeave",
      "description": "Staff leave records",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "reason": { "type": "string" }
      }
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Banking-grade audit traceability",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "description": { "type": "string" },
        "ipAddress": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "UserGroup": {
      "title": "UserGroup",
      "description": "Defined user groups with assigned rights",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "rights": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "List of right codes assigned to this group"
        },
        "status": { 
          "type": "string", 
          "enum": ["active", "inactive"],
          "default": "active"
        },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Priority banking customers",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "name": { "type": "string" },
        "segment": { "type": "string" },
        "branch": { "type": "string" },
        "rmId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "name"]
    },
    "ServiceRequest": {
      "title": "ServiceRequest",
      "description": "Service requests from customers",
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "customer_id": { "type": "string" },
        "customer_name": { "type": "string" },
        "service_type": { 
          "type": "string",
          "enum": [
            "account_opening",
            "locker",
            "demat",
            "insurance",
            "loan",
            "card_issuance",
            "other"
          ] 
        },
        "service_category": { 
          "type": "string",
          "enum": ["on_request", "annual_service", "coupon_based"],
          "description": "Service category: on-demand, annual recurring, or coupon-based"
        },
        "description": { "type": "string" },
        "priority": { 
          "type": "string",
          "enum": ["low", "medium", "high", "urgent"],
          "default": "medium"
        },
        "status": { 
          "type": "string",
          "enum": [
            "draft",
            "pending_cm",
            "pending_hopb",
            "in_progress",
            "awaiting_customer",
            "approved",
            "rejected",
            "resolved",
            "completed"
          ],
          "default": "draft"
        },
        "assigned_to": { "type": "string" },
        "cm_approval": { 
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "default": "pending"
        },
        "hopb_approval": { 
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "default": "pending"
        },
        "cm_remarks": { "type": "string" },
        "hopb_remarks": { "type": "string" },
        "due_date": { "type": "string", "format": "date" },
        "cost": { "type": "number" },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file_url": { "type": "string", "description": "URL to the uploaded file" },
              "file_name": { "type": "string", "description": "Original file name" },
              "document_type": { 
                "type": "string",
                "enum": ["kyc", "proof_of_payment", "identity", "address", "other"],
                "description": "Type of document"
              },
              "uploaded_by": { "type": "string", "description": "Email of user who uploaded" },
              "uploaded_at": { "type": "string", "format": "date-time", "description": "Upload timestamp" }
            },
            "required": ["file_url", "file_name", "document_type"]
          },
          "description": "Array of attached documents"
        },
        "created_by": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customer_name", "service_type"]
    },
    "BirthdayReminder": {
      "title": "BirthdayReminder",
      "description": "Reminders set for customer birthdays",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "reminderDate": { "type": "string", "format": "date" },
        "message": { "type": "string" },
        "sendEmail": { "type": "boolean" },
        "customerEmail": { "type": "string", "format": "email" },
        "emailSubject": { "type": "string" },
        "emailBody": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "dismissed"] },
        "createdById": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "reminderDate", "message"]
    }
    "SystemParameter": {
      "title": "SystemParameter",
      "description": "System wide configuration parameters",
      "type": "object",
      "properties": {
        "param_key": { "type": "string" },
        "param_value": { "type": "string" },
        "category": { 
          "type": "string",
          "enum": ["general", "email", "sms", "notification", "service", "threshold"]
        },
        "description": { "type": "string" },
        "is_active": { "type": "boolean", "default": true },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["param_key", "param_value"]
    }
  },
  "firestore": {
    "/birthdayReminders/{reminderId}": {
      "schema": "BirthdayReminder",
      "description": "Customer birthday reminders"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "System users collection"
    },
    "/userGroups/{groupId}": {
      "schema": "UserGroup",
      "description": "User groups and permissions"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Bank customers"
    },
    "/userRequests/{requestId}": {
      "schema": "ServiceRequest",
      "description": "Service request lifecycle tracking"
    },
    "/roles/{roleId}": {
      "schema": "Role",
      "description": "Banking roles"
    },
    "/permissions/{permissionId}": {
      "schema": "Permission",
      "description": "System rights"
    },
    "/userLeaves/{leaveId}": {
      "schema": "UserLeave",
      "description": "Staff leave management"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable audit trail"
    },
    "systemParameters/{parameterId}": {
      "schema": { "$ref": "#/entities/SystemParameter" },
      "description": "System parameters configuration"
    }
  }
}
